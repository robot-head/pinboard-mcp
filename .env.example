# Server environment; this file is not loaded automatically. Never commit secrets.
PINBOARD_PORT=4127
PINBOARD_BIND=127.0.0.1
PINBOARD_DB=data/pinboard.db
PINBOARD_DIST=crates/web/dist
# Required canonical HTTPS origin for hosted sign-in; terminate TLS at your proxy.
# PINBOARD_PUBLIC_URL=https://canvas.example.com

# Omit both for embedded Turso. Typed reads/writes use Toasty in either mode.
# TURSO_DATABASE_URL=libsql://your-database.your-region.turso.io
# TURSO_AUTH_TOKEN=

# Configure OIDC, SAML, or both. Neither enabled means trusted loopback-only mode.
# Required with either provider (comma-separated verified emails/domains):
# PINBOARD_ADMIN_EMAILS=admin@example.com
# PINBOARD_INTERNAL_DOMAINS=example.com

# OIDC: register /auth/callback as the redirect URI.
# PINBOARD_OIDC_ISSUER=https://identity.example.com
# PINBOARD_OIDC_CLIENT_ID=pinboard
# PINBOARD_OIDC_CLIENT_SECRET=
# PINBOARD_OIDC_LABEL=Company OIDC

# SAML: trusted metadata file OR HTTPS URL, plus SP RSA key/certificate PEM files.
# PINBOARD_SAML_IDP_METADATA_FILE=/run/config/idp-metadata.xml
# PINBOARD_SAML_IDP_METADATA_URL=https://identity.example.com/saml/metadata
# PINBOARD_SAML_SP_KEY_FILE=/run/secrets/pinboard-saml-key.pem
# PINBOARD_SAML_SP_CERT_FILE=/run/config/pinboard-saml-cert.pem
# PINBOARD_SAML_ENTITY_ID=https://canvas.example.com/auth/saml/metadata
# PINBOARD_SAML_EMAIL_ATTRIBUTE=email
# PINBOARD_SAML_NAME_ATTRIBUTE=displayName
# PINBOARD_SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:2.0:nameid-format:persistent
# PINBOARD_SAML_LABEL=Company SAML

# Optional SMTP invitations. TLS: starttls (default), tls, or loopback-only none.
# PINBOARD_SMTP_HOST=smtp.example.com
# PINBOARD_SMTP_PORT=587
# PINBOARD_SMTP_TLS=starttls
# PINBOARD_SMTP_FROM=Pinboard <canvas@example.com>
# PINBOARD_SMTP_USERNAME=
# PINBOARD_SMTP_PASSWORD=

# Authenticated stdio MCP: personal token from Account settings, not an SSO secret.
# PINBOARD_STDIO_TOKEN=
